<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BEST GAME EVER"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Playstyle:"
        android:textSize="20sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnButtonsSlow"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Buttons - Slow"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnButtonsFast"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Buttons - Fast"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSensorsMode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Sensors"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnViewScores"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Records And Location"
        android:textSize="16sp"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"/>

</LinearLayout>